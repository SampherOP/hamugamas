{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() == auth.uid) || (data.exists() && data.child('hostUid').val() == auth.uid))",
        "players": {
          "$playerId": {
            ".write": "auth != null && ((newData.exists() && newData.child('uid').val() == auth.uid) || !newData.exists())"
          }
        },
        "chat": {
          "$messageId": {
            ".write": "auth != null && newData.child('uid').val() == auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 300"
          }
        },
        "reactions": {
          ".write": "auth != null"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "publicUsers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && newData.child('uid').val() == auth.uid"
      }
    }
  }
}