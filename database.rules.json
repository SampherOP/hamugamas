{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "publicUsers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || newData.val() === auth.uid)"
      }
    },

    "hostRooms": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "rooms": {
      ".read": "auth != null",

      "$roomId": {
        ".read": "auth != null",

        ".write": "auth != null && (!data.exists() ? newData.child('hostUid').val() === auth.uid : data.child('hostUid').val() === auth.uid)",

        "players": {
          "$playerId": {
            ".read": "auth != null",
            ".write": "auth != null && $playerId === auth.uid"
          }
        },

        "chat": {
          "$messageId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },

        "reactions": {
          ".read": "auth != null",

          "$reaction": {
            "$uid": {
              ".read": "auth != null",
              ".write": "auth != null && $uid === auth.uid"
            }
          }
        }
      }
    },

    "votes": {
      "$date": {
        ".read": "auth != null",

        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && $uid === auth.uid"
        }
      }
    }
  }
}
