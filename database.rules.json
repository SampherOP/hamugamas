{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('hostUid').val() == auth.uid) || (data.exists() && data.child('hostUid').val() == auth.uid))",
        ".validate": "!newData.exists() || (newData.child('hostUid').isString() && newData.child('game').isString() && newData.child('host').isString() && newData.child('createdAt').isNumber())",
        "players": {
          "$playerId": {
            ".write": "auth != null && ((newData.exists() && newData.child('uid').val() == auth.uid) || (!newData.exists() && data.child('uid').val() == auth.uid))",
            ".validate": "!newData.exists() || (newData.child('uid').val() == auth.uid && newData.child('username').isString())"
          }
        },
        "chat": {
          "$messageId": {
            ".write": "auth != null && newData.exists() && newData.child('uid').val() == auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 300",
            ".validate": "newData.child('uid').val() == auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 300"
          }
        },
        "reactions": {
          ".write": "auth != null"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "publicUsers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && newData.child('uid').val() == auth.uid"
      }
    }
  }
}
